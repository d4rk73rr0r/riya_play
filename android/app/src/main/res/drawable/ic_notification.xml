<?xml version="1.0" encoding="utf-8"?>
<!--
    Status-bar icon for notifications.

    Android 5.0+ throws away every colour in a small notification icon and
    keeps only the alpha channel, so the launcher icon cannot be reused here —
    it would render as a solid white square. This is a flat white silhouette
    (a play triangle inside a rounded frame) with transparent padding, which is
    what the platform expects.
-->
