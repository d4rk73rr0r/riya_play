<?xml version="1.0" encoding="utf-8"?>
<!--
    OqTV (uzbeeline.platform24.tv) jonli efir manzillarini faqat oddiy HTTP
    orqali beradi: `/v2/channels/{id}/stream` javobidagi `hls_mbr` va `hls`
    manzillari `http://<ip>:80/...` ko'rinishida bo'ladi va o'sha hostlarda
    TLS umuman yo'q (2026-08-22 da tekshirilgan: HTTPS ulanish tushib qoladi).

    Android 9+ da (`targetSdk = 34`) shifrlanmagan trafik standart holda
    taqiqlangan, shuning uchun ExoPlayer strimni ochmasdan
    `CleartextNotPermittedException` beradi.

    Hostlar ro'yxatini yozib qo'yib bo'lmaydi: strim IP manzili har seansda
    almashadi (37.110.212.133, 37.110.212.134, 95.214.208.236 — kuzatilganlari),
    va domen emas, IP qaytadi. Shuning uchun ruxsat umumiy.

    Ilovaning qolgan barcha manbalari (finalapi.riyaplay.uz, SpecUZ, GitHub
    Releases, rasm CDN'lari) HTTPS orqali ishlaydi — bu sozlama ularni
    o'zgartirmaydi, faqat HTTP ga ruxsat beradi.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
